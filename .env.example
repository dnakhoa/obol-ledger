# The OWNER connection. Migrations and seeds use this: they create tables,
# disable triggers for backfills, and truncate. Any Postgres 15+ will do — a
# local server, or the pooled endpoint of a managed provider.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# The APPLICATION connection, optional locally and required in production.
#
# Must be a role that is neither SUPERUSER nor BYPASSRLS, because row-level
# security does not apply to one that is — and FORCE does not change that. An
# app wired to the owner credential has tenant isolation switched off in
# everything but appearance. Create the role with:
#
#   pnpm tsx scripts/provision-app-role.ts
#
# /api/v1/health reports whether the running connection is actually subject to
# the policies. Falls back to DATABASE_URL when unset, which is fine for a
# single-tenant local checkout and wrong for production.
# APP_DATABASE_URL="postgresql://obol_app:password@host/db?sslmode=require"

# Bearer token required by every /api/v1 write endpoint.
# Generate one with: openssl rand -hex 32
LEDGER_API_TOKEN="dev-token-change-me"
