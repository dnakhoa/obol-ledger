# Any Postgres 15+ connection string: a local server, or the pooled endpoint of
# a managed provider. TLS is enabled automatically for non-loopback hosts.
# The app opens real transactions — see docs/adr/0003-database-driver.md.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Bearer token required by every /api/v1 write endpoint.
# Generate one with: openssl rand -hex 32
LEDGER_API_TOKEN="dev-token-change-me"
